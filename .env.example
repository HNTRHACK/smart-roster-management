# Supabase connection used by the browser app (Vite exposes only VITE_* vars).
# Local dev: run `npx supabase start`, then copy "API URL" and "anon key"
# (or "Publishable key") from `npx supabase status`.
# Hosted: Project Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
